# Codex migration-loop guardrails. See rules.README.md before installing.
# Modified for Codex from the upstream Apache-2.0 permission template.
# No allow rules: retain the existing sandbox and approval policy.

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "Migration loop restriction: use the human-run build daemon or a human-approved batch gate.",
    match = ["git rebase"],
)

